<?xml version="1.0" encoding="UTF-8"?>
<ttFont ttLibVersion="4.63">
  <glyf>
    <!-- The xMin, yMin, xMax and yMax values
         will be recalculated by the compiler. -->
    <TTGlyph name=".notdef" xMin="80" yMin="-80" xMax="620" yMax="700">
      <contour>
        <pt x="80" y="-80" on="1"/>
        <pt x="80" y="700" on="1"/>
        <pt x="620" y="700" on="1"/>
        <pt x="620" y="-80" on="1"/>
      </contour>
      <contour>
        <pt x="105" y="-55" on="1"/>
        <pt x="595" y="-55" on="1"/>
        <pt x="595" y="675" on="1"/>
        <pt x="105" y="675" on="1"/>
      </contour>
      <instructions/>
    </TTGlyph>
  </glyf>
</ttFont>
