<?xml version="1.0" encoding="UTF-8"?>
<ttFont ttLibVersion="4.63">
  <glyf>
    <!-- The xMin, yMin, xMax and yMax values
         will be recalculated by the compiler. -->
    <TTGlyph name=".notdef" xMin="80" yMin="0" xMax="580" yMax="700">
      <contour>
        <pt x="80" y="0" on="1"/>
        <pt x="80" y="700" on="1"/>
        <pt x="580" y="700" on="1"/>
        <pt x="580" y="0" on="1"/>
      </contour>
      <contour>
        <pt x="130" y="50" on="1"/>
        <pt x="530" y="50" on="1"/>
        <pt x="530" y="650" on="1"/>
        <pt x="130" y="650" on="1"/>
      </contour>
      <instructions/>
    </TTGlyph>
  </glyf>
</ttFont>
